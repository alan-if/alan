#! /bin/bash
#
if [ $# != 2 ] ; then
    echo "Usage: `basename \"$0\"` <file> <destinationsubdirectory>"
    echo
    cat << EOF
    This script allow you to upload files to the Alan Home Pages download area
    from the command line. You need to have set up your ~/.ssh/config so that
    you can use "ssh/sftp alanif.se" to connect to alanif.se without using an
    interactive user or password. One way to do that is to ssh-copy-id to set
    up your remote ~/.ssh/authorized_keys.

    Since One.com disallowed plain ssh in their cheapest plan we are now using sftp.
    Along with that change it also became impossible to use ssh-copy-id. The current
    strategy is then to use sshpass (which you need to download/install) and it will
    use SSHPASS from the environment to login without an interactive prompt.

    If SSHPASS is not set, it will use sfp assuming you have set up your credentials
    as described above.

    ALANIF_ROOT overrides where the website lives relative to the sftp login
    directory. See below.
EOF
  exit 1
fi

# One.com's 2026 hosting restructuring moved sites down into webroots/www, so
# the login directory is no longer the website root -- uploads went on
# succeeding at connect and then failing at "dest open ... No such file or
# directory". Connecting straight into the site root keeps every path below
# relative to the website, matching what the download URLs look like.
: "${ALANIF_ROOT:=webroots/www}"

if [ "$SSHPASS" != "" ] ; then
    SFTP=(sshpass -e sftp)
else
    SFTP=(sftp)
fi

# '-b -' reads these commands from stdin the way the old heredoc did, but also
# aborts on a failed command and exits non-zero. Without it sftp walks straight
# past a failed put and reports success, so a misdirected upload leaves a green
# build and no files -- which is how the webroots/www move went unnoticed. The
# '-' on mkdir keeps an already-existing directory from tripping that.
"${SFTP[@]}" -b - "alanif.se@ssh.alanif.se:$ALANIF_ROOT" <<EOF
pwd
-mkdir downloads/$2
put "$1" "downloads/$2/$(basename "$1")"
EOF

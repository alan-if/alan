#! /bin/bash
#
# A wrapper to call the Java regression testing tool with correct
# arguments depending on platform. It assumes that the jar is in the
# same directory as this file
#
# This is a copy of the wrapper published with Jregr itself
# (github.com/thoni56/jregr, shipped as the 'jregr' asset of a release),
# with two additions belonging to this repository rather than to Jregr:
# the java check just below and the jar fetch further down. Both fail
# rather than skip; see the comment on the fetch. Everything else is
# upstream's, so diff against the released wrapper before changing it -
# the two have drifted apart before.
#
if ! command -v java &> /dev/null
then
    echo "ERROR! No java found, so no regression tests were run." >&2
    echo "       Use 'make build' to build without running any tests." >&2
    exit 1
fi

# Get path to the script since that is where the jar should also be
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
d="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# The jar is not kept in this repository. It is a release artefact of the
# separate Jregr project, so fetch it on first use and leave it there.
#
# A jar that cannot be fetched is an error, like the missing java above.
# The makefiles run this script as a plain recipe line, so exiting 0 here
# would make 'make test' and 'make ci' report success for a run in which
# not one case executed - which is what a network hiccup on a CI runner
# would otherwise produce. Nobody needs any of this to build: that is
# what 'make build' is for.
if [ ! -f "$d/jregr.jar" ]; then
  url=https://github.com/thoni56/jregr/releases/latest/download/jregr.jar
  echo "No jregr.jar in $d, fetching the latest release from $url"
  # Downloaded to a temporary name first so that an interrupted or failed
  # transfer cannot leave a truncated jar that later runs would trust.
  fetched=no
  if command -v curl &> /dev/null; then
    curl -fsSL -o "$d/jregr.jar.tmp" "$url" && fetched=yes
  elif command -v wget &> /dev/null; then
    wget -q -O "$d/jregr.jar.tmp" "$url" && fetched=yes
  else
    echo "ERROR! Neither curl nor wget found, so jregr.jar cannot be fetched." >&2
  fi
  if [ $fetched != yes ]; then
    rm -f "$d/jregr.jar.tmp"
    echo "ERROR! No jregr.jar in $d and it could not be fetched, so no" >&2
    echo "       regression tests were run. Use 'make build' to build" >&2
    echo "       without running any tests, or put a jregr.jar there by" >&2
    echo "       hand to run them without network access." >&2
    exit 1
  fi
  mv "$d/jregr.jar.tmp" "$d/jregr.jar"
fi

uname=`uname -a`
if [[ "$uname" == *[Cc]ygwin* ]]; then
  d=`cygpath -d "$d"`\\;
else
  d=$d/;
fi
java -jar "$d"jregr.jar "$@"
exit

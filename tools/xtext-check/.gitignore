# The repo-root .gitignore has a blanket `*.xml` (for generated TEST-*.xml),
# which would otherwise swallow this module's pom. Re-include it.
!pom.xml

# Maven
target/
cp.txt

# Xtext / MWE2 generated output (regenerated by `mvn generate-sources`)
src-gen/
emf-gen/
xtend-gen/
model/
# On a green generation, StandardLanguage also writes language stubs INTO src/.
# The only hand-written sources here are the grammar and the .mwe2; ignore the rest.
src/se/alanif/alan/*.java
src/se/alanif/alan/generator/
src/se/alanif/alan/scoping/
src/se/alanif/alan/validation/
src/se/alanif/alan/serializer/
src/se/alanif/alan/parser/

# ANTLR3 generator jar, if it ever gets downloaded despite the classpath dep
.antlr-generator*.jar
antlr-generator*.jar

# demo build output
demo/bin/
bin/

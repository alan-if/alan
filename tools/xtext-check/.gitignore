# The repo-root .gitignore has a blanket `*.xml` (for generated TEST-*.xml),
# which would otherwise swallow this module's pom. Re-include it.
!pom.xml

# Maven
target/
cp.txt

# Xtext / MWE2 generated output (regenerated by `mvn generate-sources`)
src-gen/
emf-gen/
xtend-gen/
model/generated/

# ANTLR3 generator jar, if it ever gets downloaded despite the classpath dep
.antlr-generator*.jar
antlr-generator*.jar

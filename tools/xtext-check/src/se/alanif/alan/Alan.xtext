grammar se.alanif.alan.Alan with org.eclipse.xtext.common.Terminals

generate alan "http://www.alanif.se/Alan"

// ==========================================================================
// Seed grammar transliterated from ParserMaker alan.pmk by pmk2xtext.py.
// Generates green (parser + shallow outline model). Hand-authored rules are
// marked '-- audit me' (STRUCTURAL/SHALLOW MODEL/LL(*) overrides).
// ==========================================================================

// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Adventure:
      OptionalOptions
      ( classes+=Class | instances+=Instance | additions+=Addition
      | synonyms+=Synonyms | messages+=Messages | syntaxes+=Syntax
      | events+=Event | rules+=Rule | prompts+=Prompt
      | Verb | 'import' )*
      Start?
;

// RETURNS: <nothing>
// has empty alternative -> optional at use site
OptionalOptions:
      (('options' | 'option') Options)?
;

// RETURNS: <nothing>
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Options:
      Option+
;

// RETURNS: <nothing>
// TODO(left-factor): ID
Option:
      AlanId '.'
    | 'no' AlanId '.'
    | AlanId AlanId '.'
    | AlanId INT '.'
;

// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Prompt:
      {Prompt} 'prompt' Statements
;

// RETURNS: atrs
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Attributes:
      (AttributeDefinition '.')+
;

// RETURNS: atr
// TODO(left-factor): ID
AttributeDefinition:
      AlanId
    | 'not' AlanId
    | AlanId OptionalMinus INT
    | AlanId STRING
    | AlanId AlanId
    | AlanId '{' OptionalMembers '}'
;

// has empty alternative -> optional at use site
OptionalMembers:
      (SetMembers)?
;

// RETURNS: set
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
SetMembers:
      SetMember (',' SetMember)*
;

SetMember:
      What
    | OptionalMinus INT
    | STRING
;

// RETURNS: syns
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Synonyms:
      {Synonyms} 'synonyms' SynonymList
;

// RETURNS: syns
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
SynonymList:
      SynonymDeclaration+
;

// RETURNS: syn
SynonymDeclaration:
      IdList '=' AlanId '.'
;

// RETURNS: msgs
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Messages:
      {Messages} 'message' MessageList
;

// RETURNS: msgs
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
MessageList:
      Message+
;

// RETURNS: msg
// TODO(predicate) %+('visits') @pmk:430
Message:
      AlanId ':' Statements
;

// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Syntax:
      {Syntax} 'syntax' SyntaxList
;

// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
SyntaxList:
      SyntaxItem+
;

SyntaxItem:
      AlanId '=' SyntaxElements OptionalSyntaxRestrictions
;

// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
SyntaxElements:
      SyntaxElement+
;

SyntaxElement:
      AlanId
    | '(' AlanId ')' OptionalIndicators
;

// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
OptionalIndicators:
      Indicator*
;

Indicator:
      '*'
    | '!'
;

// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
SyntaxRestrictionClauses:
      SyntaxRestriction ('and' SyntaxRestriction)*
;

// TODO(predicate) %+('visits') @pmk:545
SyntaxRestriction:
      AlanId 'isa' RestrictionClass 'else' Statements
;

// RETURNS: id, restrictionKind
RestrictionClass:
      AlanId
    | 'container'
;

OptionalSyntaxRestrictions:
      '.'
    | 'where' SyntaxRestrictionClauses
;

// RETURNS: vrb
Verb:
      VerbHeader VerbBody VerbTail
;

// RETURNS: srcp, str, idList
VerbHeader:
      OptionalMeta 'verb' IdList
;

// RETURNS: meta
// has empty alternative -> optional at use site
OptionalMeta:
      ('meta')?
;

VerbBody:
      SimpleVerbBody
    | VerbAlternatives
;

// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
VerbAlternatives:
      VerbAlternative+
;

VerbAlternative:
      'when' AlanId SimpleVerbBody
;

// RETURNS: srcp, chks, stms, qual
SimpleVerbBody:
      OptionalChecks OptionalDoes
;

// RETURNS: id
VerbTail:
      'end' 'verb' OptionalId '.'
;

// RETURNS: srcp, chks
// LL(*) FIX (left-factor / syntactic predicate for ANTLR3) -- audit me
// TODO(left-factor): 'check'
// has empty alternative -> optional at use site
OptionalChecks:
      ('check' (=>CheckList | Statements))?
;

// RETURNS: chks
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
CheckList:
      Check ('and' Check)*
;

// RETURNS: chk
Check:
      Expression 'else' Statements
;

// RETURNS: qual, srcp, stms
// has empty alternative -> optional at use site
OptionalDoes:
      (Does)?
;

Does:
      'does' OptionalQual Statements
;

// RETURNS: cla
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Class:
      'every' name=AlanId OptionalHeritage Properties ClassTail
;

// RETURNS: id
ClassTail:
      'end' 'every' OptionalId ('.')?
;

// RETURNS: cla
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Addition:
      'add' 'to' ('every')? name=AlanId OptionalHeritage Properties AddTail
;

// RETURNS: id
AddTail:
      'end' 'add' ('to')? OptionalId ('.')?
;

// RETURNS: ins
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Instance:
      'the' name=AlanId OptionalHeritage Properties InstanceTail
;

// RETURNS: id
InstanceTail:
      'end' 'the' OptionalId ('.')?
;

// RETURNS: id
// has empty alternative -> optional at use site
OptionalHeritage:
      (Heritage)?
;

// RETURNS: id
Heritage:
      'isa' AlanId ('.')?
;

// RETURNS: all!
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Properties:
      Property*
;

// TODO(predicate) %+('opaque') @pmk:1016
Property:
      Name
    | Pronoun
    | Where ('.')?
    | Is Attributes
    | Initialize
    | ContainerProperties
    | Description
    | Entered
    | Mentioned
    | ('indefinite')? ArticleOrForm
    | 'definite' ArticleOrForm
    | 'negative' ArticleOrForm
    | Exit
    | Verb
    | Script
;

// RETURNS: ext
Exit:
      'exit' IdList 'to' AlanId OptionalExitBody '.'
;

// RETURNS: chks, stms, id
// has empty alternative -> optional at use site
OptionalExitBody:
      (OptionalChecks OptionalDoes 'end' 'exit' OptionalId)?
;

// RETURNS: srcp
Is:
      'is'
    | 'are'
    | 'has'
    | 'can'
;

// RETURNS: description
// has empty alternative -> optional at use site
OptionalDescription:
      (Description)?
;

// RETURNS: description
// TODO(left-factor): 'description'
Description:
      'description' OptionalChecks OptionalDoes
    | 'description' Statements
;

ArticleOrForm:
      Article
    | Form
;

// RETURNS: article
// TODO(left-factor): 'article'
Article:
      'article'
    | 'article' Statements
;

// RETURNS: stms, srcp
// TODO(left-factor): 'form'
Form:
      'form'
    | 'form' Statements
;

// RETURNS: stms, srcp
Entered:
      'entered' Statements
;

// RETURNS:  
Initialize:
      'initialize' Statements
;

// RETURNS: stms, srcp
Mentioned:
      'mentioned' Statements
;

// RETURNS: nam
Name:
      'name' Ids OptionalFullStop
;

// RETURNS: idList
Pronoun:
      'pronoun' IdList OptionalFullStop
;

// TODO(predicate) %+('opaque') @pmk:1301
// has empty alternative -> optional at use site
OptionalFullStop:
      ('.')?
;

// RETURNS: cnt, srcp
ContainerProperties:
      ('with')? OptionallyOpaque 'container' ContainerBody
;

// has empty alternative -> optional at use site
OptionallyOpaque:
      ('opaque')?
;

// RETURNS: lims, stms, stms2
ContainerBody:
      OptionalTaking OptionalLimits OptionalHeader OptionalEmpty OptionalExtract
    | '.'
;

// RETURNS: id
// has empty alternative -> optional at use site
OptionalTaking:
      ('taking' AlanId '.')?
;

// RETURNS: lims
// TODO(predicate) %+('opaque') @pmk:1371
// has empty alternative -> optional at use site
OptionalLimits:
      ('limits' Limits)?
;

// RETURNS: lims
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Limits:
      Limit+
;

// RETURNS: lim
// TODO(predicate) %+('visits') @pmk:1390
Limit:
      LimitAttribute ElseOrThen Statements
;

// RETURNS: srcp
ElseOrThen:
      'else'
    | 'then'
;

// RETURNS: atr
LimitAttribute:
      AttributeDefinition
    | 'count' INT
;

// RETURNS: stms
// has empty alternative -> optional at use site
OptionalHeader:
      ('header' Statements)?
;

// RETURNS: stms
// has empty alternative -> optional at use site
OptionalEmpty:
      ('else' Statements)?
;

// RETURNS: chks, stms
// TODO(left-factor): 'extract'
// has empty alternative -> optional at use site
OptionalExtract:
      ('extract' OptionalChecks OptionalDoes | 'extract' Statements)?
;

// RETURNS: evt
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Event:
      {Event} EventHeader Statements EventTail
;

// RETURNS: srcp, id
EventHeader:
      'event' AlanId
;

// RETURNS: id
EventTail:
      'end' 'event' OptionalId '.'
;

// RETURNS: scr
Script:
      'script' AlanId ('.')? OptionalDescription StepList
;

// RETURNS: stps
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
StepList:
      Step+
;

// RETURNS: stp
// TODO(left-factor): 'step'
Step:
      'step' Statements
    | 'step' 'after' Expression ('.')? Statements
    | 'step' 'wait' 'until' Expression ('.')? Statements
;

// RETURNS: rul
// SHALLOW MODEL (Era-1 seed; outline node) -- audit me
Rule:
      {Rule} 'when' Expression Then Statements OptionalEndWhen
;

Then:
      '=>'
    | 'then'
;

// has empty alternative -> optional at use site
OptionalEndWhen:
      ('end' 'when' ('.')?)?
;

Start:
      'start' Where '.' OptionalStatements
;

// RETURNS: stms
// has empty alternative -> optional at use site
OptionalStatements:
      (Statements)?
;

// RETURNS: stms
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Statements:
      Statement+
;

// RETURNS: stm
Statement:
      OutputStatement
    | ManipulationStatement
    | AssignmentStatement
    | ConditionalStatement
    | RepetitionStatement
    | ActorStatement
    | EventStatement
    | SpecialStatement
;

// RETURNS: stm
// TODO(predicate) %-('is','are','has','can','at','here','in','nearby','near','transitively','directly','indirectly') @pmk:1642
OutputStatement:
      STRING
    | 'describe' What '.'
    | 'say' SayForm Expression '.'
    | 'list' Primary '.'
    | 'show' AlanId '.'
    | 'play' AlanId '.'
    | 'style' AlanId '.'
;

// LL(*) FIX (left-factor / syntactic predicate for ANTLR3) -- audit me
// TODO(predicate) %-('it') @pmk:1683
// has empty alternative -> optional at use site
SayForm:
      (=> ('the' | 'an' | 'it' | 'no'))?
;

// RETURNS: stm
ManipulationStatement:
      'empty' Primary OptionalWhere '.'
    | 'locate' Primary Where '.'
    | 'include' Primary 'in' What '.'
    | 'exclude' Primary 'from' What '.'
;

// RETURNS: stm
EventStatement:
      'schedule' What OptionalWhere 'after' Expression '.'
    | 'cancel' What '.'
;

// RETURNS: stm
AssignmentStatement:
      'make' Primary Something '.'
    | 'set' AttributeReference 'to' Expression '.'
    | 'increase' AttributeReference OptionalByClause '.'
    | 'decrease' AttributeReference OptionalByClause '.'
    | 'strip' OptionalFirstOrLast OptionalExpression OptionalWordOrCharacter 'from' Expression OptionalInto '.'
;

// has empty alternative -> optional at use site
OptionalByClause:
      ('by' Expression)?
;

// RETURNS: first
// TODO(predicate) %-('first') @pmk:1800
// has empty alternative -> optional at use site
OptionalFirstOrLast:
      ('first' | 'last')?
;

// has empty alternative -> optional at use site
OptionalWordOrCharacter:
      ('word' | 'words' | 'character' | 'characters')?
;

// has empty alternative -> optional at use site
OptionalInto:
      ('into' Expression)?
;

ConditionalStatement:
      IfStatement
    | DependingStatement
;

// RETURNS: stm
IfStatement:
      'if' Expression 'then' Statements OptionalElsifList OptionalElsePart 'end' 'if' '.'
;

// has empty alternative -> optional at use site
OptionalElsifList:
      (ElsifList)?
;

// RETURNS: stms
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
ElsifList:
      ('elsif' Expression 'then' Statements)+
;

// RETURNS: stms
// has empty alternative -> optional at use site
OptionalElsePart:
      ('else' Statements)?
;

DependingStatement:
      'depending' 'on' Primary DependCases 'end' ('depend' | 'depending') '.'
;

// RETURNS: cases
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
DependCases:
      DependCase+
;

// RETURNS: stm
DependCase:
      RightHandSide 'then' Statements
    | 'else' Statements
;

// RETURNS: stm
RepetitionStatement:
      ForEach AlanId OptionalLoopFilters 'do' Statements 'end' ForEach ('.')?
;

// RETURNS: ID
// has empty alternative -> optional at use site
OptionalLoopFilters:
      (Filters | 'between' Arithmetic 'and' Arithmetic)?
;

// LL(*) FIX (left-factor / syntactic predicate for ANTLR3) -- audit me
// TODO(predicate) %-('each') @pmk:1990
// TODO(left-factor): 'for'
ForEach:
      'for' 'each'? | 'each'
;

// RETURNS: stm
ActorStatement:
      'use' 'script' AlanId OptionalForActor '.'
    | 'stop' What '.'
;

// RETURNS: exp
// has empty alternative -> optional at use site
OptionalForActor:
      ('for' What)?
;

// RETURNS: stm
SpecialStatement:
      'quit' '.'
    | 'look' '.'
    | 'save' '.'
    | 'restore' '.'
    | 'restart' '.'
    | 'score' OptionalInteger '.'
    | 'visits' INT '.'
    | 'transcript' OnOrOff '.'
    | 'system' STRING '.'
;

OnOrOff:
      'on'
    | 'off'
;

// RETURNS: exp
// has empty alternative -> optional at use site
OptionalExpression:
      (Expression)?
;

// RETURNS: exp
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Expression:
      Term ('or' Term)*
;

// RETURNS: exp
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Term:
      Factor ('and' Factor)*
;

// RETURNS: exp
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
// TODO(left-factor): factor
Factor:
      Arithmetic (OptionalNot Relop Arithmetic | OptionalNot Where | OptionalNot 'between' Arithmetic 'and' Arithmetic | OptionalNot 'contains' Arithmetic)*
;

// LL(*) FIX (left-factor / syntactic predicate for ANTLR3) -- audit me
// TODO(left-factor): primary
Arithmetic:
      (Primary ('isa' AlanId | Is Something)? | Aggregate Filters) (Binop Primary)*
;

// RETURNS: exps
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Filters:
      Filter (',' Filter)*
;

// RETURNS: exp
// TODO(left-factor): optional_not
Filter:
      OptionalNot Where
    | OptionalNot 'isa' AlanId
    | Is Something
;

// TODO(left-factor): optional_not
RightHandSide:
      OptionalNot Relop Primary
    | OptionalNot 'between' Arithmetic 'and' Arithmetic
    | OptionalNot 'contains' Factor
    | Filter
;

// RETURNS: exp
// TODO(predicate) %+('is','are','has','can','at','here','in','nearby','near','transitively','directly','indirectly') @pmk:2305
// TODO(left-factor): 'random'
Primary:
      '(' Expression ')'
    | OptionalMinus INT
    | STRING
    | What
    | 'random' Primary 'to' Primary
    | 'random' OptionalTransitivity 'in' Primary
    | 'score'
    | '{' OptionalMembers '}'
;

// RETURNS: srcp, agr, id
Aggregate:
      Aggregator 'of' AlanId
    | 'count'
;

Aggregator:
      'max'
    | 'min'
    | 'sum'
;

// RETURNS: not, id
Something:
      OptionalNot AlanId
;

// RETURNS: exp
// STRUCTURAL OVERRIDE (hand-authored from alan.pmk; breaks indirect left recursion) -- audit me
What:
      (SimpleWhat | AlanId 'of' What) (':' AlanId)*
;

// RETURNS: srcp, wht
// TODO(predicate) %-('of') @pmk:2398
// TODO(left-factor): 'current'
SimpleWhat:
      AlanId
    | 'current' 'actor'
    | 'current' 'location'
    | 'this'
;

// RETURNS: exp
// LL(*) FIX (left-factor / syntactic predicate for ANTLR3) -- audit me
// TODO(predicate) %-(':') @pmk:2425
AttributeReference:
      What
;

// RETURNS: whr
// has empty alternative -> optional at use site
OptionalWhere:
      (Where)?
;

// RETURNS: srcp, whr
// TODO(left-factor): optional_transitivity
Where:
      OptionalTransitivity 'here'
    | OptionalTransitivity 'nearby'
    | OptionalTransitivity 'at' Primary
    | OptionalTransitivity 'in' Primary
    | OptionalTransitivity 'near' What
;

// RETURNS: op, srcp
Binop:
      '+'
    | '-'
    | '*'
    | '/'
;

// RETURNS: op, srcp
Relop:
      '<>'
    | '='
    | '=='
    | '>='
    | '<='
    | '>'
    | '<'
;

// RETURNS: qual, srcp
// has empty alternative -> optional at use site
OptionalQual:
      ('before' | 'after' | 'only')?
;

// TODO(predicate) %+(Identifier,'on','of','into','first','actor','opaque','taking','location') @pmk:2580
// has empty alternative -> optional at use site
OptionalNot:
      ('not')?
;

// has empty alternative -> optional at use site
OptionalTransitivity:
      ('transitively' | 'directly' | 'indirectly')?
;

// has empty alternative -> optional at use site
OptionalId:
      (AlanId)?
;

// RETURNS: idList
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
Ids:
      AlanId+
;

// RETURNS: str, idList
// de-left-recursed: A -> b (a)*  (flattens tree; associativity/precedence deferred)
IdList:
      AlanId (',' AlanId)*
;

// RETURNS: str
// has empty alternative -> optional at use site
OptionalInteger:
      (INT)?
;

// RETURNS: minus
// has empty alternative -> optional at use site
OptionalMinus:
      ('-')?
;

AlanId:
      ID
    | 'location'
    | 'actor'
    | 'opaque'
    | 'visits'
    | 'contains'
    | 'on'
    | 'it'
    | 'of'
    | 'first'
    | 'into'
    | 'taking'
    | 'off'
;

// --------------------------------------------------------------------------
terminal SL_COMMENT: '--' !('\n' | '\r')* ('\r'? '\n')?;
terminal ML_COMMENT: '////' -> '////';
